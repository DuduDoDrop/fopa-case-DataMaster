      "parameters": {
        "operation": "executeQuery",
        "query": "-- regra — os números do job (api/historico_pncp.py rodada_diaria) viram os contadores da rodada\nUPDATE execucoes_workflow\n   SET status = 'ok', duracao_s = extract(epoch FROM now() - iniciado_em), contadores = $2::jsonb,\n       cego = COALESCE(($2::jsonb ->> 'cego')::bool, false)  -- a busca de contratos caiu em algum termo\n WHERE id = $1\nRETURNING id, contadores",
        "options": {
          "queryReplacement": "={{ [ $('Abrir execução').first().json.id, JSON.stringify($json.result || {}) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "{{CRED:fopa-postgres (n8n_rw)}}",
          "name": "fopa-postgres (n8n_rw)"
        }
