        "query": "-- regra — falha não some: status erro com o motivo escrito\nUPDATE execucoes_workflow\n   SET status = 'erro', duracao_s = extract(epoch FROM now() - iniciado_em), erro = $2\n WHERE id = $1\nRETURNING id, erro",
        "options": {
