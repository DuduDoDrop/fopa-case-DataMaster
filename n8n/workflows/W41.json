    },
    {
      "id": "063308be-19f0-58f6-9e78-91aecacd82da",
      "name": "Motivo da falha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2592,
        510
      ],
      "parameters": {
        "jsCode": "// Falha vira MOTIVO escrito na linha da execução, nunca silêncio: POST recusado, worker fora, job com erro, laço esgotado.\nconst j = $input.first().json || {};\nlet motivo = j.motivo || null;\nif (!motivo) {\n  const corpo = (j.body && typeof j.body === 'object') ? j.body : {};\n  if (j.error) motivo = 'worker sem resposta: ' + String(j.error.message || j.error).slice(0, 300);\n  else if (j.statusCode) motivo = `POST /jobs/historico respondeu ${j.statusCode}: ` + String(corpo.detail || JSON.stringify(corpo)).slice(0, 300);\n  else motivo = 'falha sem detalhe';\n}\nreturn [{ json: { motivo } }];\n"
      }
    },
    {
      "id": "eb42ee10-45ac-5539-9a1d-36670eeeb145",
