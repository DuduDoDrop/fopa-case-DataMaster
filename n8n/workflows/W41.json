    {
      "id": "29b8d2c9-85ba-557b-9550-7a6a520b7598",
      "name": "Status do job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        0
      ],
      "parameters": {
        "jsCode": "// regra — laço dos jobs longos: Wait 30 s → GET /jobs/{id} enquanto `queued` OU `running`\n// (api/rotas_jobs.py; api/jobs.py — sucesso é `done`, não `ok`), máx. 150 voltas = 75 min (a rodada leva ~15 min).\n// Worker sem resposta numa volta (reinício) não mata o laço: conta a volta e pergunta de novo.\nconst MAX = 150;\nconst r = $input.first().json || {};\nconst volta = $runIndex + 1;\nconst jobId = $('POST /jobs/historico').first().json.body.job_id;\nconst b = (r.body && typeof r.body === 'object') ? r.body : {};\nlet status;\nif (r.error) status = 'sem_resposta';\nelse if (r.statusCode !== 200) status = 'http_' + r.statusCode;\nelse status = String(b.status || 'desconhecido');\nconst ativo = status === 'queued' || status === 'running' || status === 'sem_resposta';\nlet motivo = null;\nif (status === 'error') {\n  const e = b.erro || {};\n  motivo = `job ${jobId} falhou: ${e.tipo || 'erro'}: ${String(e.mensagem || '').slice(0, 300)}`;\n} else if (ativo && volta >= MAX) {\n  motivo = `job ${jobId} não terminou em ${MAX} voltas de 30 s (último status: ${status})`;\n} else if (!ativo && status !== 'done') {\n  motivo = `GET /jobs/${jobId} respondeu ${status}`;\n}\nreturn [{ json: {\n  job_id: jobId, volta, status,\n  continuar_esperando: ativo && volta < MAX,\n  concluido: status === 'done',\n  result: status === 'done' ? (b.result || {}) : null,\n  progresso: b.progresso ?? null,\n  motivo,\n} }];\n"
      }
    },
