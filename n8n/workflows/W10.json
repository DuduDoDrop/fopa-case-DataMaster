        "options": {
          "queryReplacement": "={{ [ $execution.id, (() => { const rodou = (n) => { try { return $(n).isExecuted; } catch (e) { return false; } }; return rodou('Todo dia às 6h (a cada 10 min até 7h50)') ? 'agenda' : rodou('Chamado por outro fluxo') ? 'subfluxo' : 'manual'; })() ] }}"
