# FOPA v3 - variaveis da stack docker/ (plano, secao 4 "Variaveis (nomes)").
# COPIE para `docker/.env` e preencha. O `.env` esta no .gitignore da raiz
# (`.env`, `.env.*`); este exemplo e versionado e NAO carrega valor nenhum.
#
# O compose passa cada variavel por NOME ao servico que precisa dela; nao ha
# `env_file:` em servico nenhum, entao uma variavel a mais aqui nao vaza para
# container nenhum. A ANTHROPIC_API_KEY nao existe neste arquivo de proposito:
# ela vive so na Credential do n8n (nunca em env de container).
#
# Segredos: gere com  python -c "import secrets; print(secrets.token_hex(24))"
# Senhas de Postgres entram em URL (postgresql://papel:SENHA@...): use so
# [A-Za-z0-9] (token_hex serve) para nao precisar de URL-encoding.

# ---------------------------------------------------------------- ambiente
# dev | demo | prod. `local` em FOPA_AUTH_MODE so e aceito com FOPA_ENV=demo.
FOPA_ENV=
# google | local
FOPA_AUTH_MODE=

# ---------------------------------------------------------------- URLs
# URL publica do n8n (WEBHOOK_URL e N8N_EDITOR_BASE_URL). Local: http://localhost:5679/
FOPA_N8N_PUBLIC_URL=
# URL publica do site. Local: http://localhost:8080
FOPA_SITE_URL=
# URL do worker vista pelo n8n e pela api. Dentro do compose e fixa
# (http://fopa-worker:8000); a variavel existe para a Data Table `fopa_config`
# e para o caso "worker no host" (http://host.docker.internal:8000).
#FOPA_WORKER_URL=

# ---------------------------------------------------------------- tokens
# Bearer que o n8n e a api apresentam ao worker (tudo exceto GET /health).
FOPA_WORKER_TOKEN=
# X-FOPA-Token que a api apresenta aos webhooks do n8n.
FOPA_SITE_TOKEN=
# Assina o cookie de sessao do site.
SESSION_SECRET=

# ---------------------------------------------------------------- Postgres
# Superusuario do container (banco `fopa`); so a migracao usa.
POSTGRES_PASSWORD=
# Usuario `n8n` do banco `n8n` (metadados do n8n; criado pelo init na 1a subida).
N8N_DB_PASSWORD=
# Papeis de aplicacao no banco `fopa` (criados pela migracao, senha por ALTER ROLE).
N8N_RW_PASSWORD=
WORKER_RW_PASSWORD=
API_RO_PASSWORD=
# 016: o site (fopa-api) entra como api_rw, que grava só as tabelas dele
API_RW_PASSWORD=
# O compose monta a DATABASE_URL de cada servico a partir das senhas acima
# (worker_rw no worker, api_ro na api, postgres na migracao). Preencha esta so
# para rodar `python db/migrar.py` ou a api FORA do compose, apontando para a
# porta publicada: postgresql://postgres:SENHA@127.0.0.1:5433/fopa
#DATABASE_URL=

# ---------------------------------------------------------------- n8n
# NUNCA mudar depois de subir: quebra todas as Credentials salvas.
N8N_ENCRYPTION_KEY=
# false em HTTP local; true atras de TLS (F8).
#N8N_SECURE_COOKIE=

# ---------------------------------------------------------------- storage
# fs (volume fopa_dados) no dev; s3 (R2/MinIO) em producao, mesmas chaves no
# banco (o compose.prod.yml fixa s3 e exige os S3_* abaixo). S3_ENDPOINT e so
# esquema://host (R2: https://<conta>.r2.cloudflarestorage.com); S3_REGION
# padrao auto (R2); MinIO/AWS usam a regiao do bucket.
#STORAGE_BACKEND=
#STORAGE_ROOT=
#S3_ENDPOINT=
#S3_BUCKET=
#S3_KEY=
#S3_SECRET=
#S3_REGION=

# ---------------------------------------------------------------- login Google (F2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:8080/auth/google/callback (cadastrar no Google Cloud).
# Em producao o compose.prod.yml deriva de FOPA_DOMINIO_SITE.
OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------- e-mail (fallback SMTP do W50)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------- worker
# Threads do ThreadPoolExecutor de jobs (padrao 2).
#FOPA_JOBS_CONCORRENCIA=
# Versao do Tesseract que o /health exige (ADR-008). Padrao 5.4.0; a imagem
# compila exatamente essa - mudar aqui so faz o /health responder 503.
#FOPA_TESSERACT_ESPERADO=
# sha256 do por.traineddata esperado (padrao: o pinado no Dockerfile).
#FOPA_TESSDATA_SHA256=
# Cambio USD->BRL para o custo nos relatorios. Vazio = "preco nao configurado".
#USD_BRL=

# ---------------------------------------------------------------- build
# Sha do commit gravado na imagem (/health.git_sha). Preencha na hora do build:
#   FOPA_GIT_SHA=$(git rev-parse HEAD) docker compose build fopa-worker
#FOPA_GIT_SHA=

# ---------------------------------------------------------------- producao (F8, docs/DEPLOY.md)
# So na VPS, com docker/compose.prod.yml. La o COMPOSE_FILE recebe o valor
# compose.yml:compose.prod.yml (sem aspas): todo `docker compose` ja inclui o
# override e ninguem sobe o dev em producao por esquecer o -f.
#COMPOSE_FILE=
# Hosts publicos, SEM https:// e sem barra. O Caddy emite o certificado deles,
# e o redirect do OAuth, o WEBHOOK_URL do n8n e os links dos e-mails sao
# derivados destes dois (nao ha como divergirem).
#FOPA_DOMINIO_SITE=
#FOPA_DOMINIO_N8N=
# E-mail da conta ACME (avisos do Let's Encrypt).
#ACME_EMAIL=
# Basic auth na frente do `/` do n8n (so /webhook/* e publico). O hash sai de
#   docker run --rm -it caddy:2.11.4-alpine caddy hash-password
# e vai entre ASPAS SIMPLES: o bcrypt tem `$`, que o compose interpolaria.
#CADDY_N8N_USUARIO=
#CADDY_N8N_HASH=
# Tag da imagem fopa/worker (sha curto do commit que a gerou). Rollback =
# voltar para a tag anterior e `docker compose up -d`.
#FOPA_IMAGEM_TAG=
# URL do worker vista pelo n8n em producao. Padrao: o HTTPS interno do Caddy
# (https://fopa-worker-tls:8443). Plano B: http://fopa-worker:8000.
#FOPA_WORKER_URL_N8N=
